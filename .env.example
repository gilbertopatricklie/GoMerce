Use these key and value for example :

APP_ENV=development
APP_PORT=8080
LOG_LEVEL=info

GOOSE_DRIVER=postgres
GOOSE_DBSTRING=postgres://name:your_password@localhost:5432 or 5234/db_name?sslmode=disable
GOOSE_MIGRATION_DIR=migrations

DATABASE_URL=postgresql://example_user:example_password@localhost:[your internal/local port]/exampledb

JWT_ACCESS_SECRET=SECRETVALUE
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=168h